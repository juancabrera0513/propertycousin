XANNELLO_AUTHORIZATION=replace-with-the-server-side-xannello-credential
# Optional when the frontend and serverless API use different domains:
# VITE_XANNELLO_PROXY_URL=https://example.com/api/xannello

# EmailJS browser-safe identifiers:
VITE_EMAILJS_SERVICE_ID=replace-with-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=replace-with-emailjs-template-id
VITE_EMAILJS_PUBLIC_KEY=replace-with-emailjs-public-key

# Firebase web app settings (Project Settings > Your apps):
# These identifiers are safe to expose in a browser; Firestore Security Rules
# enforce authorization for all writes.
VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
